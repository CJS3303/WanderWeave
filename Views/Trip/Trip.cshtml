@using Project1.Models
@using System.Linq
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
var trip = ViewBag.trip as Trip;
ViewData["Title"] = trip?.Name;
if (trip?.Days != null)
{
trip.Days = trip.Days.OrderBy(d => d.DayNumber).ToList();
}
}

<link rel="stylesheet" href="~/css/trip-map.css" asp-append-version="true" />
<section class="trip-workspace">
<div class="trip-itinerary bg-white rounded-lg shadow-lg p-6">
    <h1 class="text-4xl font-extrabold text-[#3AA7BC] mb-6">@trip?.Name</h1>

    <p class="text-gray-600 mb-4">Drag stops to reorder them or move them to another day.</p>
    <p id="move-status" role="status" aria-live="polite"></p>
    <div id="trip-days" class="space-y-6">
        @foreach (var day in trip?.Days ?? Enumerable.Empty<Day>())
        {
        var dayName = day.Name;
        <div class="bg-gray-50 rounded-lg border border-gray-200 p-4">
            <div class="flex items-center justify-between mb-4">
                <div class="day-name-editor">
                    <p class="text-sm text-gray-500">Day @(day.DayNumber + 1)</p>
                    <h2 class="text-2xl font-semibold text-gray-800 break-words">
                        <button type="button" class="day-name-trigger" aria-label="Rename @dayName" title="Click or right-click to rename">
                            <span>@dayName</span><span class="day-edit-hint" aria-hidden="true">✎</span>
                        </button>
                    </h2>
                    <form hidden asp-action="RenameDay" asp-route-id="@day.Id" method="post" class="day-name-form">
                        <input name="name" value="@dayName" aria-label="Day name" maxlength="100"
                               class="min-w-0 w-full border rounded px-3 py-2 bg-white text-gray-800" />
                        <div class="flex gap-2 mt-2">
                            <button type="submit" class="px-3 py-1 bg-[#3AA7BC] text-white rounded text-sm">Save</button>
                            <button type="button" class="day-name-cancel px-3 py-1 text-gray-600 text-sm">Cancel</button>
                        </div>
                    </form>
                </div>
                <div class="day-map-actions">
                <button type="button" class="preview-day" data-day-id="@day.Id" aria-pressed="false" aria-label="Preview @dayName on map">Preview day</button>
                <button
                    class="px-3 py-1 bg-red-500 hover:bg-red-600 text-white rounded text-sm"
                    onclick="deleteDay(@day.Id)">
                    Delete Day
                </button>
                </div>
            </div>

            <ul class="stop-list space-y-2 mb-4 min-h-16 rounded border border-dashed border-gray-300 p-2" data-day-id="@day.Id" data-day-name="@dayName" aria-label="Stops for @dayName">
                @foreach (var stop in day.Stops.OrderBy(s => s.SortOrder).ThenBy(s => s.Id))
                {
                <li draggable="true" data-stop-id="@stop.Id" data-stop-name="@stop.name" data-place-id="@stop.placeid" data-latlng="@stop.Latlng" class="stop-card">
                    <div class="stop-card-heading">
                    <span aria-hidden="true" class="mr-2 text-gray-400">⠿</span>
                    <input type="checkbox" class="route-stop" aria-label="Select @stop.name for route comparison" />
                    <button type="button" class="stop-map-focus text-left text-gray-700 flex-1 hover:text-[#3AA7BC]" aria-label="Show @stop.name on map"><span class="stop-route-badge" hidden aria-hidden="true"></span>@stop.name</button>
                    <button
                        class="stop-delete"
                        onclick="deleteStop(@stop.Id)">
                        Delete
                    </button>
                    </div>
                    @if (stop.ArrivalTime.HasValue || stop.DepartureTime.HasValue)
                    {
                    <p class="stop-time-summary">
                        @if (stop.ArrivalTime.HasValue)
                        {
                            <span>Arrive @stop.ArrivalTime.Value.ToString(@"hh\:mm")</span>
                        }
                        @if (stop.ArrivalTime.HasValue && stop.DepartureTime.HasValue)
                        { <span> · </span> }
                        @if (stop.DepartureTime.HasValue)
                        {
                            <span>Leave @stop.DepartureTime.Value.ToString(@"hh\:mm")</span>
                            @if (stop.ArrivalTime.HasValue && stop.DepartureTime < stop.ArrivalTime)
                            { <span> (+1 day)</span> }
                        }
                    </p>
                    }
                    <details class="stop-details">
                        <summary class="text-sm text-[#3AA7BC] cursor-pointer">
                            Times &amp; notes
                            @if (!string.IsNullOrWhiteSpace(stop.Notes))
                            { <span class="stop-notes-indicator">Has notes</span> }
                        </summary>
                        <form asp-action="SaveStopNotes" asp-route-id="@stop.Id" method="post" class="mt-2">
                            <div class="stop-time-fields">
                                <label>Arrival<input type="time" name="arrivalTime" value="@stop.ArrivalTime?.ToString(@"hh\:mm")" /></label>
                                <label>Departure<input type="time" name="departureTime" value="@stop.DepartureTime?.ToString(@"hh\:mm")" /></label>
                            </div>
                            <label for="notes-@stop.Id" class="stop-field-label">Notes</label>
                            <textarea id="notes-@stop.Id" name="notes" maxlength="4000" rows="3"
                                      class="w-full border rounded p-2 bg-white text-gray-800" placeholder="Tickets, reminders, things to do…">@stop.Notes</textarea>
                            <button type="submit" class="mt-2 px-3 py-1 bg-[#3AA7BC] text-white rounded">Save details</button>
                        </form>
                    </details>
                </li>
                }
            </ul>

            <button
                class="w-full text-left px-4 py-2 border-2 border-[#3AA7BC] text-[#3AA7BC] font-medium rounded hover:bg-[#ebf8fa] transition"
                onclick="newStop(@day.Id)">
                + Add Stop
            </button>
        </div>
        }
    </div>

    <form class="mt-8" asp-action="AddDay" asp-route-id="@trip.Id" method="post">
        <label for="new-day-name" class="block text-gray-800 font-medium mb-2">Name your new day (optional)</label>
        <input id="new-day-name" name="name" maxlength="100" placeholder="Untitled @((trip?.Days.Count ?? 0) + 1)"
               class="w-full border rounded px-3 py-2 mb-3 bg-white text-gray-800" />
        <button
            class="w-full px-6 py-3 bg-[#3AA7BC] hover:bg-[#2A8A9B] text-white font-semibold rounded-lg transition"
            type="submit">
            + ADD DAY
        </button>
    </form>
</div>
<aside class="trip-map-panel bg-white rounded-lg shadow-lg" aria-label="Trip map">
    <p id="map-status" class="p-4 text-sm text-gray-600" role="status">Loading map…</p>
    <div class="trip-map-stage">
    <div id="day-preview" class="route-overlay day-preview" aria-label="Day driving route" hidden>
        <p class="day-route-heading">Driving route</p>
        <h3 id="day-preview-name"></h3>
        <p id="day-preview-distance" role="status" aria-live="polite"></p>
        <ol id="day-route-stops" class="day-route-stops" aria-label="Stops in driving order"></ol>
        <button type="button" id="retry-day-distance" hidden>Retry distance</button>
    </div>
    <div id="route-overlay" class="route-overlay" aria-label="Compare routes">
        <div class="route-endpoints">
            <div><p><span class="route-letter">A</span> <span id="route-origin">Select a starting stop</span></p>
                 <p><span class="route-letter">B</span> <span id="route-destination">Select a destination</span></p></div>
            <button type="button" id="swap-route" disabled aria-label="Swap start and destination" title="Swap start and destination">⇅</button>
        </div>
        <div class="route-modes" role="group" aria-label="Travel mode">
            <button type="button" id="route-driving" aria-pressed="true" disabled><span>🚗 Car</span><strong id="time-driving">—</strong></button>
            <button type="button" id="route-transit" aria-pressed="false" disabled><span>🚌 Bus</span><strong id="time-transit">—</strong></button>
            <button type="button" id="route-walking" aria-pressed="false" disabled><span>🚶 Walk</span><strong id="time-walking">—</strong></button>
        </div>
        <button type="button" id="route-departure-toggle" class="departure-toggle" aria-expanded="false" aria-controls="route-schedule">Depart now ▾</button>
        <div id="route-schedule" hidden>
            <label for="route-departure-time" id="route-timezone">Departure date and time</label>
            <input type="datetime-local" id="route-departure-time" />
            <p id="departure-error" role="alert" hidden></p>
            <div class="departure-actions">
                <button type="button" id="departure-now">Use now</button>
                <button type="button" id="cancel-departure">Cancel</button>
                <button type="button" id="apply-departure">Confirm</button>
            </div>
        </div>
        <p id="route-summary" role="status" aria-live="polite" hidden></p>
        <p id="route-warnings" class="route-warnings" hidden></p>
        <details id="route-details" hidden><summary>Route details</summary><ul id="route-steps"></ul></details>
        <div class="route-actions">
            <button type="button" id="retry-route" hidden>Retry</button>
            <button type="button" id="clear-route" hidden>Clear route</button>
        </div>
    </div>
    <div id="trip-map" data-map-id="@(Configuration["GoogleMaps:MapId"] ?? "DEMO_MAP_ID")" aria-label="Map of itinerary stops"></div>
    </div>
</aside>
</section>

<dialog id="new_stop" class="modal" data-theme="light" style="color-scheme: light;">
    <div class="modal-box stop-editor">
        <div class="stop-editor-header"><h3>Add a stop</h3><p>Choose a place, then add your plans.</p></div>
        <label for="search" class="stop-field-label">Location</label>
        <input
            id="search"
            class="input input-bordered bg-white text-gray-800 w-full focus:border-[#3AA7BC] focus:ring-[#3AA7BC]"
            placeholder="Search location…"
            autocomplete="off"/>

        <div
            id="results"
            class="max-h-48 overflow-y-auto divide-y divide-gray-200 rounded-lg border border-gray-200">
            <!-- suggestions injected here -->
        </div>

        <div class="stop-time-fields">
            <label for="stop-arrival">Arrival <span>(optional)</span><input id="stop-arrival" type="time" /></label>
            <label for="stop-departure">Departure <span>(optional)</span><input id="stop-departure" type="time" /></label>
        </div>
        <p class="stop-time-hint">Local times. A departure earlier than arrival means the next day.</p>
        <label for="stop-notes" class="stop-field-label">Notes <span>(optional)</span></label>
        <textarea id="stop-notes" maxlength="4000" rows="3" placeholder="Tickets, reminders, things to do…"></textarea>

        <p id="stop_error" class="text-red-600" role="alert" hidden></p>

        <div class="modal-action flex justify-end gap-2">
            <button
                id="submit_btn"
                class="px-4 py-2 bg-[#3AA7BC] hover:bg-[#2A8A9B] text-white rounded"
                hidden>
                Add Stop
            </button>
            <button
                id="cancel_btn"
                class="px-4 py-2 bg-gray-200 text-gray-800 hover:bg-gray-300 rounded">
                Cancel
            </button>
        </div>
    </div>
</dialog>

<script src="~/js/trip-map.js" asp-append-version="true"></script>
<script>
    let autocompleteSuggestions, sessionToken, newStopDialog, searchField, resultsContainer, submitBtn, cancelBtn;
    let currentDay = 0, currentPlaceId = "", currentPlaceName = "", currentPlaceLatLong = "";

    let searchVersion = 0, savingStop = false, searchTimer;
    let mapsError = "";

    function mapsLoadFailed() {
        mapsError = "Google location search could not load. Check your connection or browser blockers, then reload.";
        showStopError(mapsError);
        window.tripMap.showError(mapsError);
    }

    window.gm_authFailure = function () {
        ++searchVersion;
        mapsError = "Google rejected location search authorization. Please share the Google Maps error from your browser console.";
        clearTimeout(searchTimer);
        document.getElementById("results").textContent = "";
        showStopError(mapsError);
        window.tripMap.showError(mapsError);
    };

    function showStopError(message) {
        const error = document.getElementById("stop_error");
        error.textContent = message;
        error.hidden = !message;
    }

    async function initMap() {
        try {
            const places = await google.maps.importLibrary("places");
            autocompleteSuggestions = places.AutocompleteSuggestion;
            window.tripMap.init();
        } catch (error) {
            console.error("Google Places initialization failed:", error);
            mapsLoadFailed();
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        newStopDialog    = document.getElementById("new_stop");
        searchField      = document.getElementById("search");
        resultsContainer = document.getElementById("results");
        submitBtn        = document.getElementById("submit_btn");
        cancelBtn        = document.getElementById("cancel_btn");

        submitBtn.hidden = true;
        searchField.addEventListener("input", onSearchInput);
        submitBtn.addEventListener("click", onSubmitStop);
        cancelBtn.addEventListener("click", () => newStopDialog.close());
        newStopDialog.addEventListener("close", () => {
            ++searchVersion;
            clearTimeout(searchTimer);
        });
    });

    async function onSearchInput(e) {
        const version = ++searchVersion;
        clearTimeout(searchTimer);
        resultsContainer.textContent = "";
        currentPlaceId = currentPlaceName = currentPlaceLatLong = "";
        submitBtn.hidden = true;
        showStopError("");
        const q = e.target.value.trim();
        if (q.length < 2) {
            resultsContainer.innerHTML = "";
            submitBtn.hidden = true;
            return;
        }
        if (mapsError || !autocompleteSuggestions) {
            showStopError(mapsError || "Google location search is still loading. Wait a moment and type again.");
            return;
        }
        resultsContainer.textContent = "Searching…";
        searchTimer = setTimeout(() => {
            if (version !== searchVersion) return;
            ++searchVersion;
            resultsContainer.textContent = "";
            showStopError("Google did not respond. Reload and try again; if this continues, share the Google Maps error from your browser console.");
        }, 10000);
        try {
            sessionToken ??= new google.maps.places.AutocompleteSessionToken();
            const { suggestions } = await autocompleteSuggestions.fetchAutocompleteSuggestions({
                input: q, sessionToken, language: "en"
            });
            if (version !== searchVersion) return;
            clearTimeout(searchTimer);
            displaySuggestions(suggestions.map(s => s.placePrediction).filter(Boolean));
        } catch (error) {
            if (version !== searchVersion) return;
            clearTimeout(searchTimer);
            resultsContainer.textContent = "";
            console.error("Google Places search failed:", error);
            showStopError("Google location search failed. Please share the Google Maps error from your browser console.");
        }
    }

    function displaySuggestions(predictions) {
        resultsContainer.innerHTML = "";
        submitBtn.hidden = true;
        if (!predictions.length) {
            showStopError("No locations found. Try another search.");
            return;
        }

        predictions.forEach(pred => {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "w-full text-left px-4 py-2 hover:bg-[#ebf8fa]";
            btn.textContent = pred.text.toString();
            btn.onclick = () => selectPrediction(pred);
            resultsContainer.appendChild(btn);
        });
    }

    async function selectPrediction(pred) {
        const version = ++searchVersion;
        clearTimeout(searchTimer);
        currentPlaceId = currentPlaceName = currentPlaceLatLong = "";
        submitBtn.hidden = true;
        showStopError("");
        searchField.value = pred.text.toString();
        resultsContainer.textContent = "Loading location…";
        const place = pred.toPlace();
        sessionToken = null;
        searchTimer = setTimeout(() => {
            if (version !== searchVersion) return;
            ++searchVersion;
            resultsContainer.textContent = "";
            showStopError("Location details timed out. Please search again.");
        }, 10000);
        try {
            await place.fetchFields({ fields: ["location"] });
            if (version !== searchVersion) return;
            if (!place.location) throw new Error("Location has no coordinates.");
            currentPlaceId = place.id;
            currentPlaceName = pred.text.toString();
            currentPlaceLatLong = `${place.location.lat()}_${place.location.lng()}`;
            submitBtn.hidden = false;
            resultsContainer.replaceChildren();
        } catch (error) {
            if (version !== searchVersion) return;
            console.error("Google Places details failed:", error);
            resultsContainer.textContent = "";
            showStopError("Could not load this location. Please search again.");
        } finally {
            if (version === searchVersion) clearTimeout(searchTimer);
        }
    }

    function newStop(day) {
        sessionToken = null;
        ++searchVersion;
        clearTimeout(searchTimer);
        currentPlaceId = currentPlaceName = currentPlaceLatLong = "";
        showStopError(mapsError);
        currentDay = day;
        document.getElementById("stop-arrival").value = "";
        document.getElementById("stop-departure").value = "";
        document.getElementById("stop-notes").value = "";
        searchField.value = "";
        resultsContainer.innerHTML = "";
        submitBtn.hidden = true;
        newStopDialog.showModal();
    }

    async function onSubmitStop() {
        if (savingStop || !currentPlaceId || !currentPlaceLatLong) return;
        savingStop = true;
        submitBtn.disabled = true;
        showStopError("");
        const data = new URLSearchParams({
            placeId: currentPlaceId,
            dayId:   currentDay,
            name:    currentPlaceName,
            latlng:  currentPlaceLatLong,
            arrivalTime: document.getElementById("stop-arrival").value,
            departureTime: document.getElementById("stop-departure").value,
            notes: document.getElementById("stop-notes").value
        });
        try {
            const response = await fetch("/Trip/AddStop", { method: "POST", body: data });
            if (!response.ok || response.redirected) throw new Error();
            location.reload();
        } catch {
            showStopError("Could not add the stop. Check your connection and sign-in, then try again.");
        } finally {
            savingStop = false;
            submitBtn.disabled = false;
        }
    }

    async function deleteStop(id) {
        if (!confirm("Delete this stop?")) return;
        const fd = new FormData(); fd.append("id", id);
        await fetch("/Trip/DeleteStop", { method: "POST", body: fd });
        location.reload();
    }

    async function deleteDay(id) {
        if (!confirm("Delete this day?")) return;
        const fd = new FormData(); fd.append("id", id);
        try {
            const response = await fetch("/Trip/DeleteDay", { method: "POST", body: fd });
            if (!response.ok || response.redirected) throw new Error();
            location.reload();
        } catch {
            alert("Could not delete the day. Check your connection and sign-in, then try again.");
        }
    }
</script>

<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAgQdSQiuSNZA6lvUKWLedy7ay_4NniyFc&libraries=places&language=en&loading=async&callback=initMap" onerror="mapsLoadFailed()" async defer></script>

<script src="~/js/stop-drag.js" asp-append-version="true"></script>

<script src="~/js/day-name.js" asp-append-version="true"></script>
